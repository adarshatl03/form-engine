{
  "name": "r-form-engine",
  "version": "3.0.3",
  "description": "A powerful, schema-driven form engine for React with visual builder, comprehensive validation, and enterprise-grade features",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib",
    "prepare": "husky",
    "predeploy": "npm run build",
    "build:site": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "deploy": "gh-pages -d dist-site"
  },
  "keywords": [
    "react",
    "form",
    "form-builder",
    "schema",
    "validation",
    "typescript",
    "tailwind",
    "dynamic-forms",
    "form-engine",
    "zod",
    "visual-builder",
    "drag-and-drop",
    "conditional-logic",
    "responsive",
    "accessibility",
    "dark-mode"
  ],
  "author": "Adarsh <adarshatl03@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adarshatl03/form-engine.git"
  },
  "bugs": {
    "url": "https://github.com/adarshatl03/form-engine/issues"
  },
  "homepage": "https://adarshatl03.github.io/form-engine/",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@progress/kendo-react-dateinputs": {
      "optional": true
    },
    "@progress/kendo-react-intl": {
      "optional": true
    },
    "@progress/kendo-licensing": {
      "optional": true
    }
  },
  "dependencies": {
    "@progress/kendo-date-math": "^1.5.15",
    "@progress/kendo-licensing": "^1.8.0",
    "@progress/kendo-react-common": "^13.2.0",
    "@progress/kendo-react-dateinputs": "^13.2.0",
    "@progress/kendo-react-intl": "^13.2.0",
    "@progress/kendo-react-popup": "^13.2.0",
    "@progress/kendo-theme-default": "^12.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.0.0",
    "zod": ">=3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.7",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "tsc --noEmit"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
