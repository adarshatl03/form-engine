{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx"
  },
  "include": ["src/lib/**/*", "src/components/**/*", "src/hooks/**/*", "src/context/**/*", "src/types/**/*", "src/utils/**/*"]
}
